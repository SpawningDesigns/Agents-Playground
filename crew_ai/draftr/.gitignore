# ── Local venv (if someone runs uv sync inside draftr/ directly) ────────────
# The canonical venv lives at Agents-Playground/.venv (workspace root).
.venv/
__pycache__/
*.pyc
.DS_Store
dist/
*.egg-info/

# ── ChromaDB vector store — large binary files, regenerated by ingest_bids ──
knowledge/vault/

# ── Past bid documents — may contain proprietary or confidential content ────
knowledge/past_bids/*
!knowledge/past_bids/.gitkeep

# ── Internal design documents — not for distribution or source control ───────
docs/*.docx
docs/~$*

# ── Task outputs — generated on every run ───────────────────────────────────
output/
